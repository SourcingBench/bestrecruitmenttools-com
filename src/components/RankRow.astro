---
import { stars, PRICE_LABEL } from '../data/site';
import Logo from './Logo.astro';
interface Props { tool: any; why?: string; pos?: number; }
const { tool: t, why, pos } = Astro.props;
---
<li class={`rankrow${pos === 1 ? ' top' : ''}`}>
  <div class="no"><Logo slug={t.slug} name={t.name} />{pos && <span class="pos" aria-hidden="true">{pos}</span>}</div>
  <div>
    <span class="tag">{t.category}</span>
    <h3><a href={`/reviews/${t.slug}/`}>{t.name}</a></h3>
    <p>{why ?? t.verdict}</p>
    <div class="pm"><div class="plus">{t.standout}</div><div class="minus">{t.weakness}</div></div>
  </div>
  <div class="meta"><span class="stars" aria-label={`${t.rating} out of 5`}>{stars(t.rating)}</span><b>{t.rating.toFixed(1)}<small>/ 5</small></b><span>{t.priceTier} · {PRICE_LABEL[t.priceTier]}</span><span>Best for: {t.bestFor}</span></div>
  {pos === 1 && <span class="pick">Editor's pick</span>}
</li>
