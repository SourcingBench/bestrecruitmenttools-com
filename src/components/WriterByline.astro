---
import { writerFor } from '../data/writers';
const w = writerFor(Astro.props.path ?? Astro.url.pathname);
---
<span class="writer-byline"><span aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#e7e1d6;color:#2b2b2b;font-size:10px;font-weight:700;vertical-align:middle;margin-right:6px">{w.initials}</span>By <a href={`/authors/${w.slug}/`} rel="author">{w.name}</a></span>
