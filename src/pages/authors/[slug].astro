---
import Base from '../../layouts/Base.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';
import usecases from '../../data/usecases.json';
import tools from '../../data/tools.json';
import compare from '../../data/compare.json';
import { WRITERS, writerFor, personLd } from '../../data/writers';
const tn = Object.fromEntries(tools.map((t) => [t.slug, t.name]));
const ALL = [...usecases.map((u) => ({ path: `/best-for/${u.slug}/`, name: u.title })), ...compare.map((c) => ({ path: `/compare/${c.a}-vs-${c.b}/`, name: `${tn[c.a]} vs ${tn[c.b]}` })), ...tools.map((t) => ({ path: `/reviews/${t.slug}/`, name: `${t.name} review` }))];
export function getStaticPaths() { return WRITERS.map((w) => ({ params: { slug: w.slug }, props: { w } })); }
const { w } = Astro.props as any;
const mine = ALL.filter((p) => writerFor(p.path).slug === w.slug);
const schema = [{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { ...personLd(w), description: w.bio } }];
---
<Base title={`${w.name}, Writer | ${SITE_NAME}`} description={w.bio} path={`/authors/${w.slug}/`} schema={schema}>
  <div class="wrap narrow prose"><p class="crumbs"><a href="/">Home</a> › <a href="/authors/">Writers</a> › {w.name}</p><h1>{w.name}</h1>
      <p>{w.bio}</p>
      <h2>Pages by {w.name}</h2>
      <ul>{mine.map((m) => <li><a href={m.path}>{m.name}</a></li>)}</ul>
      <p><a href="/authors/">All writers</a></p>
  </div>
</Base>
