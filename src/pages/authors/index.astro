---
import Base from '../../layouts/Base.astro';
import { SITE_NAME, SITE_URL } from '../../data/site';
import usecases from '../../data/usecases.json';
import tools from '../../data/tools.json';
import compare from '../../data/compare.json';
import { WRITERS } from '../../data/writers';
const schema = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Writers', hasPart: WRITERS.map((w) => ({ '@type': 'Person', name: w.name, url: `${SITE_URL}/authors/${w.slug}/` })) }];
---
<Base title={`Writers | ${SITE_NAME}`} description={`The writers behind ${SITE_NAME}.`} path="/authors/" schema={schema}>
  <div class="wrap narrow prose"><p class="crumbs"><a href="/">Home</a> › Writers</p><h1>Our writers</h1>
      <p>The writers behind {SITE_NAME}. Every page carries the name of the writer responsible for it; rankings follow the published method and no vendor pays for placement.</p>
      <ul class="writer-list">{WRITERS.map((w) => <li><a href={`/authors/${w.slug}/`}><b>{w.name}</b></a>: {w.bio}</li>)}</ul>
  </div>
</Base>
