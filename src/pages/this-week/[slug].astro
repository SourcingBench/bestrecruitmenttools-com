---
import Base from '../../layouts/Base.astro';
import roundups from '../../data/roundups.json';
import { articleSchema, breadcrumbSchema, AUTHOR_NAME, fmtDate } from '../../data/site';
export function getStaticPaths() { return roundups.map((r) => ({ params: { slug: r.slug }, props: { r } })); }
const { r } = Astro.props;
const path = `/this-week/${r.slug}/`;
const schema = [
  articleSchema({ headline: r.title, description: r.summary, path, published: r.date, updated: r.date }),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'This week', path: '/this-week/' }, { name: r.period, path }]),
];
---
<Base title={r.title} description={r.summary} path={path} schema={schema}>
  <article class="wrap">
    <p class="eyebrow"><a href="/this-week/">This week in recruiting tools</a> · <time datetime={r.date}>{r.period}</time></p>
    <h1>{r.title}</h1>
    <p class="lead">{r.summary}</p>
    <p class="byline">By {AUTHOR_NAME} · Published {fmtDate(r.date)}</p>
    {r.items.map((i) => (
      <section class="item">
        <h2>{i.vendor}: {i.headline}</h2>
        <p class="cat">{i.category}</p>
        <p set:html={i.detail} />
        <p class="matters"><b>Why it matters.</b> <span set:html={i.matters} /></p>
      </section>
    ))}
    {r.directory && <section class="item"><h2>On this site</h2><p set:html={r.directory} /></section>}
    <p class="foot">Sources are the vendors' own announcements and the trade press named in each item, read in the week stated. Corrections: <a href="/contact/">contact the editors</a>. Previous editions: <a href="/this-week/">all roundups</a>.</p>
  </article>
</Base>
<style>
  .wrap { max-width: 800px; margin: 2rem auto 3rem; padding: 0 1rem; line-height: 1.65; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; opacity: .75; margin: 0 0 .4rem; }
  .lead { font-size: 1.15rem; }
  .byline { font-size: .9rem; opacity: .75; }
  .item { margin-top: 1.75rem; }
  .item h2 { font-size: 1.25rem; line-height: 1.35; margin: 0 0 .25rem; }
  .cat { margin: 0 0 .5rem; font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; opacity: .7; }
  .matters { border-left: 3px solid #ddd; padding-left: .9rem; margin: .5rem 0 0; }
  .foot { margin-top: 2.5rem; font-size: .9rem; opacity: .8; }
</style>
