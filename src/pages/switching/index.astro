---
import Base from '../../layouts/Base.astro';
import guides from '../../data/switching.json';
import { breadcrumbSchema, itemListSchema, SITE_URL, YEAR } from '../../data/site';
const path = '/switching/';
const schema = [
  itemListSchema('Recruiting tool switching guides', guides.map((g) => ({ name: g.title, url: `${SITE_URL}/switching/${g.slug}/` }))),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Switching guides', path }]),
];
---
<Base title={`How to switch recruiting tools: vendor-neutral migration guides (${YEAR})`} description="Step-by-step, vendor-neutral guides for leaving a recruiting tool: what exports, how to time the renewal, how to run old and new in parallel, what breaks, and which alternatives fit which team." path={path} schema={schema}>
  <section class="wrap">
    <p class="eyebrow">Switching guides</p>
    <h1>How to switch recruiting tools</h1>
    <p class="lead">Leaving a tool is a project, not a cancellation. Each guide covers what you can export, the steps in order, what usually breaks in the first month, and which of the tools we rank fit which situation. Written by the editorial board; no vendor pays for placement (<a href="/how-we-rank/">how we rank</a>).</p>
    {guides.map((g) => (
      <article class="card">
        <h2><a href={`/switching/${g.slug}/`}>{g.title}</a></h2>
        <p>{g.short}</p>
      </article>
    ))}
    <p>See also: <a href="/this-week/">this week in recruiting tools</a> · <a href="/">top 10 recruitment tools {YEAR}</a>.</p>
  </section>
</Base>
<style>
  .wrap { max-width: 800px; margin: 2rem auto 3rem; padding: 0 1rem; line-height: 1.6; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; opacity: .7; margin: 0 0 .4rem; }
  .lead { font-size: 1.1rem; }
  .card { border: 1px solid #e5e5e5; border-radius: 12px; padding: 1.25rem 1.5rem; margin: 1.25rem 0; }
  .card h2 { margin: 0 0 .5rem; font-size: 1.25rem; line-height: 1.3; }
</style>
