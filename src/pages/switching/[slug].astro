---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import guides from '../../data/switching.json';
import tools from '../../data/tools.json';
import { articleSchema, breadcrumbSchema, faqSchema, AUTHOR_NAME, fmtDate, YEAR } from '../../data/site';
export function getStaticPaths() { return guides.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props;
const by = Object.fromEntries(tools.map((t) => [t.slug, t]));
const path = `/switching/${g.slug}/`;
const schema = [
  articleSchema({ headline: g.title, description: g.short, path, published: g.date, updated: g.date }),
  { '@context': 'https://schema.org', '@type': 'HowTo', name: g.title, description: g.short, step: g.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) },
  faqSchema(g.faq),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Switching guides', path: '/switching/' }, { name: g.from, path }]),
];
---
<Base title={`${g.title} (${YEAR} migration guide)`} description={g.short} path={path} schema={schema}>
  <article class="wrap">
    <p class="eyebrow"><a href="/switching/">Switching guides</a></p>
    <h1>{g.title}</h1>
    <p class="lead">{g.short}</p>
    <p class="byline">By {AUTHOR_NAME} · Published {fmtDate(g.date)}</p>
    <h2>What you can take with you</h2>
    <p>{g.exports}</p>
    <h2>Steps, in order</h2>
    <ol>{g.steps.map((s) => <li>{s}</li>)}</ol>
    <h2>What usually breaks</h2>
    <ul>{g.breaks.map((b) => <li>{b}</li>)}</ul>
    <h2>Which alternative, by situation</h2>
    <ul>{g.alternatives.map((a) => (
      <li><b>{a.when}:</b> {a.tools.map((s, i) => (<>{i > 0 && ', '}<a href={`/reviews/${s}/`}>{by[s].name}</a></>))}</li>
    ))}</ul>
    <Faq items={g.faq} title="Related questions" />
    <p><a href="/switching/">All switching guides</a> · <a href="/this-week/">This week in recruiting tools</a> · <a href="/">Top 10 recruitment tools {YEAR}</a></p>
  </article>
</Base>
<style>
  .wrap { max-width: 800px; margin: 2rem auto 3rem; padding: 0 1rem; line-height: 1.65; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; opacity: .75; margin: 0 0 .4rem; }
  .lead { font-size: 1.15rem; }
  .byline { font-size: .9rem; opacity: .75; }
  ol, ul { padding-left: 1.3rem; }
</style>
